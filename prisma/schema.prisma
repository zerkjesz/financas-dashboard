generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Usada só pelo Prisma Migrate (shadow database, DDL) — nunca pelo runtime da
  // aplicação (lib/prisma.js usa o driver adapter da Neon direto com DATABASE_URL,
  // não passa por aqui). Neon/PgBouncer em modo pooled não garante os comandos de
  // nível de sessão que Migrate precisa (Fase 3.1, Etapa 0 — ver docs/dev-environment.md).
  directUrl = env("DIRECT_URL")
}

// Fase 3.2 — confiança do dado, independente de `source` (que é proveniência: de
// onde o registro veio; confidence é "o quanto confiamos que este valor é exato").
// Ver lib/dataConfidence.js pro helper que resolve o valor na fronteira de criação
// e docs/schema-v2-blueprint.md pro racional original.
enum DataConfidence {
  CONFIRMED
  CONFIRMED_BY_MEMORY
  ESTIMATED
  UNCERTAIN
  RECONCILIATION_ADJUSTMENT
}

model Account {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  type      String // "checking" | "cash" | "food_voucher"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incomes            Income[]
  expenses           Expense[]
  transfersFrom      Transfer[]            @relation("TransferFromAccount")
  transfersTo        Transfer[]            @relation("TransferToAccount")
  balanceAdjustments BalanceAdjustment[]
  recurringRules     RecurringRule[]
  cards              Card[]
  bills              Bill[]
  reserves           Reserve[]
  fundedCommitments  ConfirmedCommitment[]
}

model Card {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  accountId  String?
  account    Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  totalLimit Decimal  @db.Decimal(12, 2)
  closingDay Int? // null = desconhecido, editável depois
  dueDay     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  expenses        Expense[]
  purchases       Purchase[]
  bills           CardBill[]
  limitUpdates    CardLimitUpdate[]
  transfers       Transfer[]
  creditMovements CardCreditMovement[]
}

model Income {
  id                      String          @id @default(cuid())
  amount                  Decimal         @db.Decimal(12, 2)
  description             String
  category                String          @default("Outros")
  accountId               String
  account                 Account         @relation(fields: [accountId], references: [id])
  recurringRuleId         String?
  recurringRule           RecurringRule?  @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  isRecurring             Boolean         @default(false)
  source                  String          @default("manual") // "telegram" | "manual" | "migration"
  // Nullable de propósito, SEM default de banco (Fase 3.2) — registro pré-existente
  // (migrado antes desta fase) fica NULL = "não classificado", nunca uma afirmação
  // silenciosa de CONFIRMED que a migration não tem como saber se é verdade. Todo
  // registro NOVO passa por lib/dataConfidence.js:resolveConfidence() na fronteira
  // de criação, que aplica CONFIRMED como default só ali (nunca via @default aqui).
  confidence              DataConfidence?
  rawMessage              String?
  legacyTransactionId     String?         @unique
  // Fase 4.0.2 — identifica EXPLICITAMENTE qual ocorrência prevista de
  // `recurringRuleId` este Income realiza, pela DATA EXATA prevista (não por mês
  // calendário nem ciclo financeiro — os três são conceitos diferentes e não
  // devem se misturar num só campo, ver lib/incomeHorizon.js). Nullable de
  // propósito, SEM default/backfill (mesma política de não-afirmação retroativa
  // da Fase 3.2): todo Income existente antes desta fase fica com
  // recurringOccurrenceDate NULL, mesmo que já tenha recurringRuleId setado —
  // vínculo explícito só passa a existir via
  // lib/incomeHorizon.js:recordRecurringIncomeOccurrence()/
  // linkIncomeToRecurringOccurrence(), nunca por heurística.
  recurringOccurrenceDate DateTime?       @db.Date
  occurredAt              DateTime        @default(now())
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  receivable Receivable?

  @@unique([recurringRuleId, recurringOccurrenceDate])
  @@index([occurredAt])
  @@index([accountId])
}

model Expense {
  id                  String          @id @default(cuid())
  amount              Decimal         @db.Decimal(12, 2)
  description         String
  category            String          @default("Outros")
  accountId           String?
  account             Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  cardId              String?
  card                Card?           @relation(fields: [cardId], references: [id], onDelete: SetNull)
  recurringRuleId     String?
  recurringRule       RecurringRule?  @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  billId              String?         @unique
  bill                Bill?           @relation(fields: [billId], references: [id], onDelete: SetNull)
  isRecurring         Boolean         @default(false)
  source              String          @default("manual")
  // Ver comentário equivalente em Income.confidence — mesma política.
  confidence          DataConfidence?
  rawMessage          String?
  legacyTransactionId String?         @unique
  occurredAt          DateTime        @default(now())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  externalInstallment ExternalInstallment?
  confirmedCommitment ConfirmedCommitment?

  // Invariante de app (não garantida pelo Prisma): exatamente um de accountId/cardId deve estar setado.
  @@index([occurredAt])
  @@index([accountId])
  @@index([cardId])
}

model Transfer {
  id            String          @id @default(cuid())
  amount        Decimal         @db.Decimal(12, 2)
  description   String
  fromAccountId String?
  fromAccount   Account?        @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: SetNull)
  toAccountId   String?
  toAccount     Account?        @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  toCardId      String?
  toCard        Card?           @relation(fields: [toCardId], references: [id], onDelete: SetNull)
  cardBillId    String?
  cardBill      CardBill?       @relation(fields: [cardBillId], references: [id], onDelete: SetNull)
  kind          String          @default("generic") // "generic" | "card_bill_payment" | "installment_anticipation"
  source        String          @default("manual")
  // Ver comentário em Income.confidence — mesma política (nullable, sem default de banco).
  confidence    DataConfidence?
  rawMessage    String?
  occurredAt    DateTime        @default(now())
  createdAt     DateTime        @default(now())

  @@index([occurredAt])
}

model BalanceAdjustment {
  id         String          @id @default(cuid())
  accountId  String
  account    Account         @relation(fields: [accountId], references: [id])
  newBalance Decimal         @db.Decimal(12, 2)
  note       String?
  source     String          @default("manual") // "telegram" | "manual" | "migration"
  // Ver comentário em Income.confidence — mesma política (nullable, sem default de banco).
  confidence DataConfidence?
  rawMessage String?
  occurredAt DateTime        @default(now())
  createdAt  DateTime        @default(now())

  @@index([accountId, occurredAt])
}

model CardLimitUpdate {
  id                String          @id @default(cuid())
  cardId            String
  card              Card            @relation(fields: [cardId], references: [id])
  newTotalLimit     Decimal?        @db.Decimal(12, 2) // setado só se o limite total também mudou
  newUsedLimit      Decimal         @db.Decimal(12, 2) // valor-âncora
  reportedAvailable Decimal?        @db.Decimal(12, 2) // valor bruto que o usuário informou, mantido pra auditoria
  note              String?
  source            String          @default("manual")
  // Ver comentário em Income.confidence — mesma política (nullable, sem default de banco).
  confidence        DataConfidence?
  rawMessage        String?
  occurredAt        DateTime        @default(now())
  createdAt         DateTime        @default(now())

  @@index([cardId, occurredAt])
}

model Purchase {
  id                        String          @id @default(cuid())
  description               String
  totalAmount               Decimal         @db.Decimal(12, 2)
  installmentCount          Int
  installmentValue          Decimal         @db.Decimal(12, 2)
  category                  String          @default("Outros")
  cardId                    String
  card                      Card            @relation(fields: [cardId], references: [id])
  firstInstallmentMonth     String // "2026-09" (YYYY-MM)
  startingInstallmentNumber Int             @default(1)
  source                    String          @default("manual")
  // Ver comentário em Income.confidence — mesma política (nullable, sem default de banco).
  confidence                DataConfidence?
  rawMessage                String?
  purchasedAt               DateTime        @default(now())
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  installments Installment[]

  @@index([cardId])
}

model Installment {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  number     Int
  amount     Decimal  @db.Decimal(12, 2)
  billMonth  String // "2026-09"
  createdAt  DateTime @default(now())

  @@unique([purchaseId, number])
  @@index([billMonth])
}

model CardBill {
  id          String    @id @default(cuid())
  cardId      String
  card        Card      @relation(fields: [cardId], references: [id])
  cycleMonth  String // "2026-08"
  closesAt    DateTime
  dueAt       DateTime
  totalAmount Decimal   @default(0) @db.Decimal(12, 2)
  status      String    @default("open") // "open" | "closed" | "paid"
  paidAt      DateTime?
  paidAmount  Decimal?  @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  transfers Transfer[]

  @@unique([cardId, cycleMonth])
}

// Fase 3.2 — reavaliado explicitamente e DECIDIDO NÃO adicionar `confidence` aqui.
// RecurringRule é uma REGRA futura (config de recorrência), não um fato financeiro
// reconstruído — "confiança" não tem referente claro pra um valor que ainda vai
// acontecer (confiança em quê? no valor que a Bill materializada vai ter? essa Bill
// já tem seu próprio `confidence`, no momento em que o fato existe de verdade). Sem
// justificativa semântica clara, não adiciona campo especulativo.
model RecurringRule {
  id         String   @id @default(cuid())
  name       String // "Vale Alimentação - Recarga", "Aluguel", "Luz", "Internet", "Salário"
  kind       String // "income" | "expense"
  amount     Decimal? @db.Decimal(12, 2) // null se variável (ex: luz muda todo mês)
  dayOfMonth Int // 1-31
  accountId  String?
  account    Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  incomes  Income[]
  expenses Expense[]
  bills    Bill[]

  @@index([isActive])
}

model Bill {
  id              String          @id @default(cuid())
  description     String
  amount          Decimal         @db.Decimal(12, 2)
  category        String?         @default("Outros")
  accountId       String?
  account         Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  dueDate         DateTime
  recurringRuleId String?
  recurringRule   RecurringRule?  @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  cycleMonth      String? // só quando gerada a partir de uma RecurringRule ("2026-09")
  status          String          @default("pending") // "pending" | "paid" | "overdue" | "cancelled"
  notes           String?
  source          String          @default("manual") // "manual" | "telegram"
  // Ver comentário em Income.confidence — mesma política (nullable, sem default de banco).
  confidence      DataConfidence?
  rawMessage      String?
  paidAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  expense Expense?

  @@unique([recurringRuleId, cycleMonth])
  @@index([dueDate])
  @@index([status])
}

model Goal {
  id           String    @id @default(cuid())
  name         String
  targetAmount Decimal   @db.Decimal(12, 2)
  savedAmount  Decimal   @default(0) @db.Decimal(12, 2)
  targetDate   DateTime?
  notes        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ============================================================================
// Fase 3.3 — Domain Models V2. Só estrutura + services; nenhum valor real
// cadastrado, nenhum snapshot, nenhuma integração automática com freeMoney/
// financialStatus ainda (isso é trabalho de fase futura — ver docs do blueprint).
// ============================================================================

// --- Reserve: alocação virtual de dinheiro dentro de uma Account real ---------

// Sem ambiguidade de sinal — cada kind já diz a direção (nunca um ADJUSTMENT
// genérico com sinal escondido no `amount`, que é SEMPRE positivo).
//   ALLOCATE        + (primeira alocação de dinheiro pra dentro da reserva)
//   REPLENISH       + (reposição — cobre o "replenishment gap")
//   RELEASE         - (dinheiro sai da reserva, ex: funda um ConfirmedCommitment)
//   ADJUST_INCREASE + (correção manual pra cima)
//   ADJUST_DECREASE - (correção manual pra baixo)
enum ReserveMovementKind {
  ALLOCATE
  REPLENISH
  RELEASE
  ADJUST_INCREASE
  ADJUST_DECREASE
}

// Reserve NÃO tem campo de saldo mutável — de propósito. O saldo é sempre a soma
// assinada do ledger (ReserveMovement), igual ao padrão já usado em Account
// (BalanceAdjustment) e Card (CardLimitUpdate) — ver lib/reserves.js:getReserveBalance.
model Reserve {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id])
  name         String
  targetAmount Decimal? @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movements         ReserveMovement[]
  fundedCommitments ConfirmedCommitment[]

  @@index([accountId])
}

model ReserveMovement {
  id         String              @id @default(cuid())
  reserveId  String
  reserve    Reserve             @relation(fields: [reserveId], references: [id])
  amount     Decimal             @db.Decimal(12, 2) // SEMPRE positivo — CHECK no banco, ver migration.sql
  kind       ReserveMovementKind
  occurredAt DateTime            @default(now())
  note       String?
  confidence DataConfidence?
  createdAt  DateTime            @default(now())

  @@index([reserveId, occurredAt])
}

// --- External installments: parcelas fora do cartão pessoal (dívida com outra
// pessoa, financiamento direto com um credor etc — ex: MacBook, Casa Ubatuba) ---

// Só ACTIVE/CANCELLED — decisão do usuário sobre o PLANO em si (ele desistiu? foi
// cancelado?). "Todas as parcelas foram pagas" é um estado DERIVADO das
// ExternalInstallment (ver lib/externalInstallments.js:isPlanFullyPaid), nunca uma
// terceira opção manual aqui — evita duas fontes de verdade pra a mesma pergunta
// ("está completo?"), que é exatamente o anti-padrão que este model deve evitar.
enum ExternalInstallmentPlanStatus {
  ACTIVE
  CANCELLED
}

// Fase 5.2B — estratégia temporal do plano. Fonte ÚNICA de verdade sobre timing
// (nunca duplicada no ExternalInstallment filho — ver comentário lá): um plano
// tradicional tem uma data de calendário real conhecida; um plano cujo fato
// conhecido é só "pago geralmente logo depois do próximo salário/renda, dia
// exato desconhecido" NUNCA deve forçar uma data de calendário inventada só
// pra satisfazer o schema — CALENDAR_DATE vs AFTER_NEXT_INCOME é exatamente
// essa distinção, explícita e fechada (nunca uma String livre).
enum ExternalInstallmentDueTiming {
  CALENDAR_DATE // firstDueDate/dueDate são datas de calendário reais, conhecidas.
  AFTER_NEXT_INCOME // sem data exata conhecida — só "vence relativo à próxima renda". firstDueDate/dueDate ficam null; ver lib/obligationClassifier.js pra como isso é classificado.
}

model ExternalInstallmentPlan {
  id               String                        @id @default(cuid())
  description      String
  creditor         String // pessoa/entidade credora — "mãe", "namorada", "loja X"
  installmentValue Decimal                       @db.Decimal(12, 2)
  installmentCount Int
  // Nullable de propósito (Fase 5.2B) — obrigatório em CALENDAR_DATE, deve ficar
  // ausente em AFTER_NEXT_INCOME (nunca uma data de calendário inventada pra
  // satisfazer NOT NULL). Validado em lib/externalInstallments.js na fronteira
  // de criação, não só aqui no schema.
  firstDueDate     DateTime?
  dueTiming        ExternalInstallmentDueTiming  @default(CALENDAR_DATE)
  status           ExternalInstallmentPlanStatus @default(ACTIVE)
  confidence       DataConfidence?
  notes            String?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  installments ExternalInstallment[]
}

enum ExternalInstallmentStatus {
  PENDING
  PAID
}

model ExternalInstallment {
  id        String                    @id @default(cuid())
  planId    String
  plan      ExternalInstallmentPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  number    Int
  amount    Decimal                   @db.Decimal(12, 2)
  // Nullable de propósito (Fase 5.2B) — null exatamente quando plan.dueTiming ==
  // AFTER_NEXT_INCOME (sem sentinel fake tipo 1970-01-01/2099-01-01/data do
  // salário/data de hoje). dueTiming NÃO é duplicado aqui — é lido do Plan
  // (fonte única) por quem classifica (lib/obligationClassifier.js), que também
  // decide, por número/status entre as irmãs do mesmo plano, se ESTA parcela é
  // a próxima-a-vencer (NEXT_INCOME_WINDOW_COMMITMENT) ou uma futura mais atrás
  // na fila (FUTURE_OBLIGATION) — nunca todas as parcelas restantes de uma vez.
  dueDate   DateTime?
  status    ExternalInstallmentStatus @default(PENDING)
  paidAt    DateTime?
  // Opcional de propósito: parcela paga antes do início do histórico operacional
  // (ver AppSettings.operationalHistoryStart) pode estar PAID sem ter um Expense
  // operacional correspondente — reconstruir esse histórico não é objetivo desta
  // fase. Confidence NÃO existe aqui: é herdada semanticamente do Plan (a parcela é
  // gerada deterministicamente a partir dele, não é um fato independente).
  expenseId String?                   @unique
  expense   Expense?                  @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@unique([planId, number])
  @@index([dueDate])
}

// --- ConfirmedCommitment: obrigação confirmada sem origem definida ainda -------

// CONFIRMED != FUNDED != SETTLED, sempre (Fase 2, decisão bloqueante já fechada):
//   CONFIRMED — obrigação existe e é real, mas nenhuma decisão de funding ainda.
//   FUNDED    — já existe decisão de origem do dinheiro (Reserve ou Account).
//               NÃO significa que o pagamento aconteceu.
//   SETTLED   — o movimento financeiro real aconteceu e está vinculado (expenseId).
//   CANCELLED — obrigação descartada; não pode transicionar pra SETTLED depois.
enum ConfirmedCommitmentStatus {
  CONFIRMED
  FUNDED
  SETTLED
  CANCELLED
}

model ConfirmedCommitment {
  id          String                    @id @default(cuid())
  description String
  amount      Decimal                   @db.Decimal(12, 2)
  dueDate     DateTime
  status      ConfirmedCommitmentStatus @default(CONFIRMED)

  // Origem do funding — no máximo uma das duas é usada na prática (a v1 dos
  // services só implementa o caminho por Reserve, ver lib/commitments.js;
  // fundingAccountId fica reservado no schema pra um funding direto por Account,
  // trabalho futuro, sem necessidade de migration nova quando chegar a hora).
  fundingAccountId String?
  fundingAccount   Account?  @relation(fields: [fundingAccountId], references: [id], onDelete: SetNull)
  fundingReserveId String?
  fundingReserve   Reserve?  @relation(fields: [fundingReserveId], references: [id], onDelete: SetNull)
  fundedAt         DateTime?

  settledAt DateTime?
  expenseId String?   @unique // impede dois commitments settled no mesmo Expense
  expense   Expense?  @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  notes      String?
  confidence DataConfidence?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([status])
  @@index([dueDate])
}

// --- Contingency: risco/possível gasto futuro, NUNCA entra em freeMoney --------

enum ContingencyStatus {
  AWAITING_INFORMATION
  CONFIRMED
  DISMISSED
}

model Contingency {
  id             String            @id @default(cuid())
  description    String
  expectedAmount Decimal?          @db.Decimal(12, 2) // CHECK 0 <= expectedAmount <= maxAmount, ver migration.sql
  maxAmount      Decimal           @db.Decimal(12, 2) // CHECK maxAmount > 0
  expectedDate   DateTime?
  status         ContingencyStatus @default(AWAITING_INFORMATION)
  notes          String?
  confidence     DataConfidence?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

// --- Receivable: dinheiro a receber — NUNCA conta como recebido só pela data ---

enum ReceivableStatus {
  PENDING
  RECEIVED
  CANCELLED
}

model Receivable {
  id           String           @id @default(cuid())
  description  String
  counterparty String
  amount       Decimal          @db.Decimal(12, 2)
  expectedDate DateTime?
  status       ReceivableStatus @default(PENDING)
  incomeId     String?          @unique // impede dois receivables vinculados ao mesmo Income
  income       Income?          @relation(fields: [incomeId], references: [id], onDelete: SetNull)
  confidence   DataConfidence?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

// --- CategoryBudget: config/intenção por ciclo, não fato reconstruído ----------
// Sem `confidence` de propósito (ver Fase 3.2, item 11) — isto é uma escolha do
// usuário sobre o futuro, não uma reconstrução de um fato passado.

model CategoryBudget {
  id         String   @id @default(cuid())
  category   String
  cycleStart DateTime @db.Date // só a data, sem componente de hora — ver comentário abaixo
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // cycleEnd deliberadamente NÃO existe aqui — é sempre derivável de cycleStart +
  // AppSettings.cycleStartDay (duração de um ciclo == até o dia anterior ao próximo
  // cycleStartDay). Armazenar os dois seria uma segunda fonte de verdade que pode
  // divergir se AppSettings mudar depois.
  @@unique([category, cycleStart])
}

// --- CardCreditMovement: saldo credor do CARTÃO (não da fatura) ----------------

// Mesma disciplina de sinal do ReserveMovementKind — nunca um kind genérico.
//   CREDIT_GRANTED  + (crédito concedido — ex: pagou mais que o restante da fatura)
//   CREDIT_APPLIED  - (crédito consumido — ex: abateu uma compra nova)
//   ADJUST_INCREASE + (correção manual pra cima)
//   ADJUST_DECREASE - (correção manual pra baixo)
//
// IMPORTANTE: este ledger nunca apaga/reduz Purchase/Expense original — aplicar
// crédito é só um efeito no SALDO CREDOR, o gasto real continua exatamente como
// foi lançado (ver exemplo no cabeçalho de lib/cardCredit.js).
enum CardCreditMovementKind {
  CREDIT_GRANTED
  CREDIT_APPLIED
  ADJUST_INCREASE
  ADJUST_DECREASE
}

model CardCreditMovement {
  id         String                 @id @default(cuid())
  cardId     String
  card       Card                   @relation(fields: [cardId], references: [id])
  amount     Decimal                @db.Decimal(12, 2) // SEMPRE positivo — CHECK no banco, ver migration.sql
  kind       CardCreditMovementKind
  occurredAt DateTime               @default(now())
  note       String?
  confidence DataConfidence?
  // Referências soltas (sem @relation — só rastreabilidade, não uma FK de verdade;
  // evita ter que abrir mão-dupla de array em CardBill/Transfer só pra isso) pro
  // evento que originou este movimento, quando aplicável.
  cardBillId String?
  transferId String?
  createdAt  DateTime               @default(now())

  @@index([cardId, occurredAt])
}

model PendingBotMessage {
  id            String   @id @default(cuid())
  chatId        String   @unique
  intent        String
  parsedPayload Json
  promptMessage String
  rawMessage    String
  createdAt     DateTime @default(now())
  expiresAt     DateTime
}

// Estado do assistente guiado por botões (ex: /contas-novas). Um por chat — enquanto
// existir, mensagens/toques daquele chat pertencem ao assistente, não ao parser normal.
model BotWizardSession {
  id        String   @id @default(cuid())
  chatId    String   @unique
  flow      String // "nova_conta"
  step      String
  data      Json
  messageId Int? // id da mensagem do Telegram, pra editar em vez de mandar uma nova a cada passo
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// Configuração singleton do app (Fase 3.2). `id` fixo em "default" — todo código
// que lê/escreve este model deve sempre usar esse id explícito (ver lib/settings.js).
// Fixar o id como chave primária é a garantia de "no máximo 1 linha": uma segunda
// tentativa de `create` com o mesmo id colide com a constraint de unicidade da PK
// em vez de silenciosamente virar uma segunda config. O singleton é semeado
// explicitamente (scripts/seed-app-settings.mjs) — NUNCA por um get-or-create
// escondido dentro de uma leitura (ver lib/settings.js:getAppSettings, que é
// estritamente read-only).
model AppSettings {
  id String @id @default("default")

  // Dia em que o ciclo financeiro pessoal começa (1-31) — ainda não aplicado a
  // nenhuma query nesta fase (isso é Fase de ciclo/snapshot); só armazenado.
  cycleStartDay Int

  // Percentual (não é dinheiro — de propósito NÃO é Decimal(12,2), que é a escala
  // certa pra valor monetário em Real, não pra um percentual de margem de
  // segurança). Inteiro representando pontos percentuais inteiros (10 = 10%),
  // mesmo estilo de cycleStartDay — simples, suficiente pro caso de uso (config
  // editada raramente por humano, não agregada/computada em série), e evita
  // reintroduzir Float pra um valor novo depois de toda a Fase 3.1 ter existido
  // basicamente pra tirar Float de campo calculado. Se precisão fracionária vier
  // a ser necessária (ex: 7.5%), é uma migration futura pequena e isolada.
  safetyMarginPercent Int

  // Cortes de histórico operacional — armazenados nesta fase, mas AINDA NÃO
  // aplicados a nenhuma query do dashboard (isso é a fase de ciclo/snapshot;
  // ver Fase 3.2, item 5). Nada de julho é escondido ou apagado agora.
  operationalHistoryStart DateTime
  vaHistoryStart          DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tabela `Transaction` original, renomeada — arquivo permanente, a app não escreve mais nela.
model LegacyTransaction {
  id                 String   @id @default(cuid())
  type               String
  amount             Float
  category           String   @default("Outros")
  paymentMethod      String?
  isRecurring        Boolean  @default(false)
  description        String
  rawMessage         String
  source             String   @default("telegram")
  occurredAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  // Colunas que já existiam na tabela real (adicionadas fora do histórico de migrations) —
  // preservadas aqui pra não serem derrubadas pelo diff do rename.
  installmentCurrent Int?
  installmentTotal   Int?

  @@map("transaction_legacy")
}
