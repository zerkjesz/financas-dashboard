generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Usada só pelo Prisma Migrate (shadow database, DDL) — nunca pelo runtime da
  // aplicação (lib/prisma.js usa o driver adapter da Neon direto com DATABASE_URL,
  // não passa por aqui). Neon/PgBouncer em modo pooled não garante os comandos de
  // nível de sessão que Migrate precisa (Fase 3.1, Etapa 0 — ver docs/dev-environment.md).
  directUrl = env("DIRECT_URL")
}

// Fase 3.2 — confiança do dado, independente de `source` (que é proveniência: de
// onde o registro veio; confidence é "o quanto confiamos que este valor é exato").
// Ver lib/dataConfidence.js pro helper que resolve o valor na fronteira de criação
// e docs/schema-v2-blueprint.md pro racional original.
enum DataConfidence {
  CONFIRMED
  CONFIRMED_BY_MEMORY
  ESTIMATED
  UNCERTAIN
  RECONCILIATION_ADJUSTMENT
}

model Account {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  type      String // "checking" | "cash" | "food_voucher"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incomes            Income[]
  expenses           Expense[]
  transfersFrom      Transfer[]          @relation("TransferFromAccount")
  transfersTo        Transfer[]          @relation("TransferToAccount")
  balanceAdjustments BalanceAdjustment[]
  recurringRules     RecurringRule[]
  cards              Card[]
  bills              Bill[]
}

model Card {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  accountId  String?
  account    Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  totalLimit Decimal @db.Decimal(12, 2)
  closingDay Int? // null = desconhecido, editável depois
  dueDay     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  expenses     Expense[]
  purchases    Purchase[]
  bills        CardBill[]
  limitUpdates CardLimitUpdate[]
  transfers    Transfer[]
}

model Income {
  id                  String         @id @default(cuid())
  amount              Decimal        @db.Decimal(12, 2)
  description         String
  category            String         @default("Outros")
  accountId           String
  account             Account        @relation(fields: [accountId], references: [id])
  recurringRuleId     String?
  recurringRule       RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  isRecurring         Boolean        @default(false)
  source              String         @default("manual") // "telegram" | "manual" | "migration"
  // Nullable de propósito, SEM default de banco (Fase 3.2) — registro pré-existente
  // (migrado antes desta fase) fica NULL = "não classificado", nunca uma afirmação
  // silenciosa de CONFIRMED que a migration não tem como saber se é verdade. Todo
  // registro NOVO passa por lib/dataConfidence.js:resolveConfidence() na fronteira
  // de criação, que aplica CONFIRMED como default só ali (nunca via @default aqui).
  confidence          DataConfidence?
  rawMessage          String?
  legacyTransactionId String?        @unique
  occurredAt          DateTime       @default(now())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([occurredAt])
  @@index([accountId])
}

model Expense {
  id                  String         @id @default(cuid())
  amount              Decimal        @db.Decimal(12, 2)
  description         String
  category            String         @default("Outros")
  accountId           String?
  account             Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  cardId              String?
  card                Card?          @relation(fields: [cardId], references: [id], onDelete: SetNull)
  recurringRuleId     String?
  recurringRule       RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  billId              String?        @unique
  bill                Bill?          @relation(fields: [billId], references: [id], onDelete: SetNull)
  isRecurring         Boolean        @default(false)
  source              String         @default("manual")
  // Ver comentário equivalente em Income.confidence — mesma política.
  confidence          DataConfidence?
  rawMessage          String?
  legacyTransactionId String?        @unique
  occurredAt          DateTime       @default(now())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Invariante de app (não garantida pelo Prisma): exatamente um de accountId/cardId deve estar setado.
  @@index([occurredAt])
  @@index([accountId])
  @@index([cardId])
}

model Transfer {
  id            String    @id @default(cuid())
  amount        Decimal   @db.Decimal(12, 2)
  description   String
  fromAccountId String?
  fromAccount   Account?  @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: SetNull)
  toAccountId   String?
  toAccount     Account?  @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  toCardId      String?
  toCard        Card?     @relation(fields: [toCardId], references: [id], onDelete: SetNull)
  cardBillId    String?
  cardBill      CardBill? @relation(fields: [cardBillId], references: [id], onDelete: SetNull)
  kind          String    @default("generic") // "generic" | "card_bill_payment" | "installment_anticipation"
  source        String    @default("manual")
  // Ver comentário em Income.confidence — mesma política (nullable, sem default de banco).
  confidence    DataConfidence?
  rawMessage    String?
  occurredAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([occurredAt])
}

model BalanceAdjustment {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id])
  newBalance Decimal @db.Decimal(12, 2)
  note       String?
  source     String   @default("manual") // "telegram" | "manual" | "migration"
  // Ver comentário em Income.confidence — mesma política (nullable, sem default de banco).
  confidence DataConfidence?
  rawMessage String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([accountId, occurredAt])
}

model CardLimitUpdate {
  id                String   @id @default(cuid())
  cardId            String
  card              Card     @relation(fields: [cardId], references: [id])
  newTotalLimit     Decimal? @db.Decimal(12, 2) // setado só se o limite total também mudou
  newUsedLimit      Decimal  @db.Decimal(12, 2) // valor-âncora
  reportedAvailable Decimal? @db.Decimal(12, 2) // valor bruto que o usuário informou, mantido pra auditoria
  note              String?
  source            String   @default("manual")
  // Ver comentário em Income.confidence — mesma política (nullable, sem default de banco).
  confidence        DataConfidence?
  rawMessage        String?
  occurredAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([cardId, occurredAt])
}

model Purchase {
  id                        String   @id @default(cuid())
  description               String
  totalAmount               Decimal  @db.Decimal(12, 2)
  installmentCount          Int
  installmentValue          Decimal  @db.Decimal(12, 2)
  category                  String   @default("Outros")
  cardId                    String
  card                      Card     @relation(fields: [cardId], references: [id])
  firstInstallmentMonth     String // "2026-09" (YYYY-MM)
  startingInstallmentNumber Int      @default(1)
  source                    String   @default("manual")
  // Ver comentário em Income.confidence — mesma política (nullable, sem default de banco).
  confidence                DataConfidence?
  rawMessage                String?
  purchasedAt               DateTime @default(now())
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  installments Installment[]

  @@index([cardId])
}

model Installment {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  number     Int
  amount     Decimal  @db.Decimal(12, 2)
  billMonth  String // "2026-09"
  createdAt  DateTime @default(now())

  @@unique([purchaseId, number])
  @@index([billMonth])
}

model CardBill {
  id          String    @id @default(cuid())
  cardId      String
  card        Card      @relation(fields: [cardId], references: [id])
  cycleMonth  String // "2026-08"
  closesAt    DateTime
  dueAt       DateTime
  totalAmount Decimal   @default(0) @db.Decimal(12, 2)
  status      String    @default("open") // "open" | "closed" | "paid"
  paidAt      DateTime?
  paidAmount  Decimal?  @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  transfers Transfer[]

  @@unique([cardId, cycleMonth])
}

// Fase 3.2 — reavaliado explicitamente e DECIDIDO NÃO adicionar `confidence` aqui.
// RecurringRule é uma REGRA futura (config de recorrência), não um fato financeiro
// reconstruído — "confiança" não tem referente claro pra um valor que ainda vai
// acontecer (confiança em quê? no valor que a Bill materializada vai ter? essa Bill
// já tem seu próprio `confidence`, no momento em que o fato existe de verdade). Sem
// justificativa semântica clara, não adiciona campo especulativo.
model RecurringRule {
  id         String   @id @default(cuid())
  name       String // "Vale Alimentação - Recarga", "Aluguel", "Luz", "Internet", "Salário"
  kind       String // "income" | "expense"
  amount     Decimal? @db.Decimal(12, 2) // null se variável (ex: luz muda todo mês)
  dayOfMonth Int // 1-31
  accountId  String?
  account    Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  incomes  Income[]
  expenses Expense[]
  bills    Bill[]

  @@index([isActive])
}

model Bill {
  id              String         @id @default(cuid())
  description     String
  amount          Decimal        @db.Decimal(12, 2)
  category        String?        @default("Outros")
  accountId       String?
  account         Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  dueDate         DateTime
  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  cycleMonth      String? // só quando gerada a partir de uma RecurringRule ("2026-09")
  status          String         @default("pending") // "pending" | "paid" | "overdue" | "cancelled"
  notes           String?
  source          String         @default("manual") // "manual" | "telegram"
  // Ver comentário em Income.confidence — mesma política (nullable, sem default de banco).
  confidence      DataConfidence?
  rawMessage      String?
  paidAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  expense Expense?

  @@unique([recurringRuleId, cycleMonth])
  @@index([dueDate])
  @@index([status])
}

model Goal {
  id           String    @id @default(cuid())
  name         String
  targetAmount Decimal   @db.Decimal(12, 2)
  savedAmount  Decimal   @default(0) @db.Decimal(12, 2)
  targetDate   DateTime?
  notes        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model PendingBotMessage {
  id            String   @id @default(cuid())
  chatId        String   @unique
  intent        String
  parsedPayload Json
  promptMessage String
  rawMessage    String
  createdAt     DateTime @default(now())
  expiresAt     DateTime
}

// Estado do assistente guiado por botões (ex: /contas-novas). Um por chat — enquanto
// existir, mensagens/toques daquele chat pertencem ao assistente, não ao parser normal.
model BotWizardSession {
  id        String   @id @default(cuid())
  chatId    String   @unique
  flow      String // "nova_conta"
  step      String
  data      Json
  messageId Int? // id da mensagem do Telegram, pra editar em vez de mandar uma nova a cada passo
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// Configuração singleton do app (Fase 3.2). `id` fixo em "default" — todo código
// que lê/escreve este model deve sempre usar esse id explícito (ver lib/settings.js).
// Fixar o id como chave primária é a garantia de "no máximo 1 linha": uma segunda
// tentativa de `create` com o mesmo id colide com a constraint de unicidade da PK
// em vez de silenciosamente virar uma segunda config. O singleton é semeado
// explicitamente (scripts/seed-app-settings.mjs) — NUNCA por um get-or-create
// escondido dentro de uma leitura (ver lib/settings.js:getAppSettings, que é
// estritamente read-only).
model AppSettings {
  id String @id @default("default")

  // Dia em que o ciclo financeiro pessoal começa (1-31) — ainda não aplicado a
  // nenhuma query nesta fase (isso é Fase de ciclo/snapshot); só armazenado.
  cycleStartDay Int

  // Percentual (não é dinheiro — de propósito NÃO é Decimal(12,2), que é a escala
  // certa pra valor monetário em Real, não pra um percentual de margem de
  // segurança). Inteiro representando pontos percentuais inteiros (10 = 10%),
  // mesmo estilo de cycleStartDay — simples, suficiente pro caso de uso (config
  // editada raramente por humano, não agregada/computada em série), e evita
  // reintroduzir Float pra um valor novo depois de toda a Fase 3.1 ter existido
  // basicamente pra tirar Float de campo calculado. Se precisão fracionária vier
  // a ser necessária (ex: 7.5%), é uma migration futura pequena e isolada.
  safetyMarginPercent Int

  // Cortes de histórico operacional — armazenados nesta fase, mas AINDA NÃO
  // aplicados a nenhuma query do dashboard (isso é a fase de ciclo/snapshot;
  // ver Fase 3.2, item 5). Nada de julho é escondido ou apagado agora.
  operationalHistoryStart DateTime
  vaHistoryStart          DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tabela `Transaction` original, renomeada — arquivo permanente, a app não escreve mais nela.
model LegacyTransaction {
  id                 String   @id @default(cuid())
  type               String
  amount             Float
  category           String   @default("Outros")
  paymentMethod      String?
  isRecurring        Boolean  @default(false)
  description        String
  rawMessage         String
  source             String   @default("telegram")
  occurredAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  // Colunas que já existiam na tabela real (adicionadas fora do histórico de migrations) —
  // preservadas aqui pra não serem derrubadas pelo diff do rename.
  installmentCurrent Int?
  installmentTotal   Int?

  @@map("transaction_legacy")
}
