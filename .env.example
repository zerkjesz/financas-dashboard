# DATABASE_URL local aponta pro branch de DEV/TEST do Neon, NUNCA pro branch de
# produção (main). Veja docs/dev-environment.md pra como criar esse branch e por quê.
# Produção só existe como variável de ambiente na Vercel (Project Settings ->
# Environment Variables -> Production) — nunca num arquivo .env local.
DATABASE_URL="postgresql://usuario:senha@ep-XXXXXXXX-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Declaração explícita de que este ambiente NÃO é produção. Scripts de teste
# (scripts/lib/assertTestEnvironment.js) exigem "development" ou "test" aqui pra
# aceitar escrever qualquer dado — sem essa variável, eles abortam (fail closed).
DATABASE_ENV=development

# Token do bot no Telegram (@BotFather)
TELEGRAM_TOKEN=seu_token_aqui

# Secret que o Telegram envia de volta no header X-Telegram-Bot-Api-Secret-Token do
# webhook — configurado via setWebhook(..., secret_token=...). Ver plano de segurança
# em docs/schema-v2-blueprint.md, item 12.
TELEGRAM_WEBHOOK_SECRET=

# chat_id do Telegram do único usuário autorizado a mandar mensagem pro bot.
OWNER_CHAT_ID=

# Autenticação do dashboard web (ver docs/schema-v2-blueprint.md, item 11,
# implementada na Fase 5.3C — lib/auth/**, middleware.js).
# DASHBOARD_PASSWORD_HASH: saída de `node scripts/generate-password-hash.mjs "sua senha"`
# — formato "scrypt:N:r:p:saltHex:hashHex" (":" e não "$" — o loader de env do
# Next.js interpola "$NOME" mesmo dentro de aspas simples, o que corromperia
# um hash no formato $ tradicional). NUNCA a senha em texto puro.
DASHBOARD_PASSWORD_HASH=

# SESSION_SECRET: 32+ bytes aleatórios (64+ chars hex), independente da senha
# — gerar com `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
SESSION_SECRET=

# Fase 5.3C, item 24 — bypass de auth (web + Telegram) SOMENTE pra
# desenvolvimento local, NUNCA default, NUNCA aceito em produção mesmo se
# setado por engano (middleware.js/lib/auth/envConfig.js travam isso
# explicitamente). Deixe vazio/ausente pra continuar exigindo login/allowlist
# também em dev (preferível).
AUTH_DEV_BYPASS=
